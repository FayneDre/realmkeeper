{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realmkeeper.github.io/schema/v1/component.schema.json",
  "title": "Component manifest",
  "description": "A shared third-party runtime (database server, redistributable...). Lives at catalog/components/<id>.json.",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "kind", "version", "license", "homepage", "platforms"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "name": { "type": "string" },
    "kind": { "enum": ["database", "runtime"] },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "channel": { "description": "Upstream release channel, e.g. 'lts'.", "type": "string" },
    "license": { "$ref": "common.schema.json#/$defs/spdxLicense" },
    "homepage": { "type": "string", "format": "uri" },
    "platforms": {
      "description": "Keyed by '<os>-<arch>' (e.g. 'windows-x86_64', 'linux-x86_64').",
      "type": "object",
      "propertyNames": { "pattern": "^(windows|linux|macos)-(x86_64|aarch64)$" },
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["upstream", "size", "sha256", "executables"],
        "properties": {
          "upstream": {
            "description": "Official download (used by CI to build and smoke-test servers).",
            "type": "string",
            "format": "uri"
          },
          "size": {
            "description": "Exact size of the upstream download in bytes.",
            "type": "integer",
            "minimum": 1
          },
          "unpackedSize": {
            "description": "Approximate size in bytes once unpacked, measured on a real install (free-space check before an install).",
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "description": "sha256 of the upstream download, computed once and cross-checked against the vendor's published checksum. Anything else is rejected.",
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "executables": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "extras": {
            "description": "Libraries the upstream download expects from the system but some systems lack (SteamOS has no package installation): official packages of another distribution, downloaded from their permanent upstream URL (never re-hosted) and verified, whose files are copied into the unpacked component.",
            "type": "array",
            "items": {
              "type": "object",
              "required": ["upstream", "size", "sha256", "format", "files"],
              "properties": {
                "upstream": { "type": "string", "format": "uri" },
                "size": { "type": "integer", "minimum": 1 },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "format": { "description": "Package format: 'deb' (ar archive with data.tar.*).", "enum": ["deb"] },
                "files": {
                  "description": "Regular file in the package (path without leading './') -> destination relative to the component root.",
                  "type": "object",
                  "minProperties": 1,
                  "propertyNames": { "pattern": "^[A-Za-z0-9._+-]+(/[A-Za-z0-9._+-]+)*$" },
                  "additionalProperties": { "type": "string", "pattern": "^[A-Za-z0-9._+-]+(/[A-Za-z0-9._+-]+)*$" }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
