{
  "$schema": "../../../schema/module.schema.json",
  "schemaVersion": 1,
  "id": "mod-transmog",
  "emulator": "azerothcore",
  "name": {
    "en": "Transmogrification",
    "fr": "Transmogrification"
  },
  "description": {
    "en": "Change the look of your gear with the appearance of other items you collected. A GM places the transmogrifier with .npc add 190010; a portable one comes with the module.",
    "fr": "Change l'apparence de ton équipement avec celle d'objets que tu as collectés. Un MJ place le transmogrifieur avec .npc add 190010 ; une version portable est fournie avec le module."
  },
  "category": "cosmetic",
  "homepage": "https://github.com/azerothcore/mod-transmog",
  "license": "AGPL-3.0",
  "source": {
    "repo": "https://github.com/azerothcore/mod-transmog",
    "ref": "master",
    "commit": "d309745c9151ff2ea4202204c1efa991848414bf"
  },
  "compatibleFlavors": [
    "playerbot"
  ],
  "requires": [],
  "conflicts": [],
  "removable": true,
  "activation": {
    "mode": "config",
    "enable": {
      "modules/transmog.conf": {
        "Transmogrification.Enable": 1
      }
    },
    "disable": {
      "modules/transmog.conf": {
        "Transmogrification.Enable": 0
      }
    }
  },
  "database": {
    "dbimportId": "mod-transmog",
    "applyWhenDisabled": true,
    "touches": [
      "auth",
      "characters",
      "world"
    ]
  },
  "config": {
    "files": [
      {
        "file": "modules/transmog.conf",
        "dist": "modules/transmog.conf.dist"
      }
    ]
  },
  "options": [
    {
      "id": "collection",
      "type": "boolean",
      "label": {
        "en": "Unlock appearances by collecting items",
        "fr": "Débloquer les apparences en collectant les objets"
      },
      "target": {
        "file": "modules/transmog.conf",
        "key": "Transmogrification.UseCollectionSystem"
      },
      "default": true
    },
    {
      "id": "portable",
      "type": "boolean",
      "label": {
        "en": "Portable transmogrifier",
        "fr": "Transmogrifieur portable"
      },
      "target": {
        "file": "modules/transmog.conf",
        "key": "Transmogrification.EnablePortable"
      },
      "default": true
    },
    {
      "id": "cost",
      "type": "number",
      "label": {
        "en": "Cost multiplier",
        "fr": "Multiplicateur de coût"
      },
      "target": {
        "file": "modules/transmog.conf",
        "key": "Transmogrification.ScaledCostModifier"
      },
      "default": 1,
      "min": 0,
      "max": 100
    },
    {
      "id": "hidden",
      "type": "boolean",
      "label": {
        "en": "Allow hiding a piece of gear",
        "fr": "Permettre de masquer une pièce d'équipement"
      },
      "target": {
        "file": "modules/transmog.conf",
        "key": "Transmogrification.AllowHiddenTransmog"
      },
      "default": true
    },
    {
      "id": "sets",
      "type": "boolean",
      "label": { "en": "Saved outfits", "fr": "Tenues enregistrées" },
      "target": { "file": "modules/transmog.conf", "key": "Transmogrification.EnableSets" },
      "default": true
    },
    {
      "id": "allow-poor",
      "type": "boolean",
      "label": { "en": "Poor (grey) items", "fr": "Objets médiocres (gris)" },
      "target": { "file": "modules/transmog.conf", "key": "Transmogrification.AllowPoor" },
      "default": false
    },
    {
      "id": "allow-common",
      "type": "boolean",
      "label": { "en": "Common (white) items", "fr": "Objets communs (blancs)" },
      "target": { "file": "modules/transmog.conf", "key": "Transmogrification.AllowCommon" },
      "default": false
    },
    {
      "id": "allow-legendary",
      "type": "boolean",
      "label": { "en": "Legendary items", "fr": "Objets légendaires" },
      "target": { "file": "modules/transmog.conf", "key": "Transmogrification.AllowLegendary" },
      "default": false
    },
    {
      "id": "mixed-armor",
      "type": "boolean",
      "label": {
        "en": "Mix armor types (cloth look on plate...)",
        "fr": "Mélanger les types d'armure (tissu sur plaques...)"
      },
      "target": {
        "file": "modules/transmog.conf",
        "key": "Transmogrification.AllowMixedArmorTypes"
      },
      "default": false
    },
    {
      "id": "mixed-weapons",
      "type": "boolean",
      "label": { "en": "Mix weapon types", "fr": "Mélanger les types d'armes" },
      "target": {
        "file": "modules/transmog.conf",
        "key": "Transmogrification.AllowMixedWeaponTypes"
      },
      "default": false
    },
    {
      "id": "ignore-level",
      "type": "boolean",
      "label": {
        "en": "Ignore the item's required level",
        "fr": "Ignorer le niveau requis de l'objet"
      },
      "target": { "file": "modules/transmog.conf", "key": "Transmogrification.IgnoreReqLevel" },
      "default": false
    }
  ],
  "optionGroups": [
    {
      "id": "rules",
      "label": { "en": "What can be used as a look", "fr": "Ce qui peut servir d'apparence" },
      "options": [
        "allow-poor",
        "allow-common",
        "allow-legendary",
        "mixed-armor",
        "mixed-weapons",
        "ignore-level"
      ]
    }
  ],
  "spawns": [
    {
      "creature": 190010,
      "places": [
        "Stormwind",
        "Orgrimmar"
      ]
    }
  ]
}
