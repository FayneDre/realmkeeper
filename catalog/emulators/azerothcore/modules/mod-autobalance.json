{
  "$schema": "../../../schema/module.schema.json",
  "schemaVersion": 1,
  "id": "mod-autobalance",
  "emulator": "azerothcore",
  "name": {
    "en": "Auto Balance",
    "fr": "Équilibrage automatique"
  },
  "description": {
    "en": "Scales dungeon and raid creatures to the number of players in the group, so a small group can clear group content.",
    "fr": "Adapte les créatures des donjons et des raids au nombre de joueurs du groupe, pour qu'un petit groupe puisse en venir à bout."
  },
  "category": "gameplay",
  "homepage": "https://github.com/azerothcore/mod-autobalance",
  "license": "NOASSERTION",
  "source": {
    "repo": "https://github.com/azerothcore/mod-autobalance",
    "ref": "master",
    "commit": "1d707cb61a0962ab01e4123681e2d3b66cc558a2"
  },
  "compatibleFlavors": [
    "playerbot"
  ],
  "requires": [],
  "conflicts": [],
  "removable": true,
  "activation": {
    "mode": "config",
    "enable": {
      "modules/AutoBalance.conf": {
        "AutoBalance.Enable.Global": 1
      }
    },
    "disable": {
      "modules/AutoBalance.conf": {
        "AutoBalance.Enable.Global": 0
      }
    }
  },
  "database": {
    "dbimportId": "mod-autobalance",
    "touches": []
  },
  "config": {
    "files": [
      {
        "file": "modules/AutoBalance.conf",
        "dist": "modules/AutoBalance.conf.dist"
      }
    ]
  },
  "options": [
    {
      "id": "dungeons",
      "type": "boolean",
      "label": {
        "en": "Balance 5-player dungeons",
        "fr": "Équilibrer les donjons à 5"
      },
      "target": {
        "file": "modules/AutoBalance.conf",
        "key": "AutoBalance.Enable.5M"
      },
      "default": true
    },
    {
      "id": "raids-10",
      "type": "boolean",
      "label": {
        "en": "Balance 10-player raids",
        "fr": "Équilibrer les raids à 10"
      },
      "target": {
        "file": "modules/AutoBalance.conf",
        "key": "AutoBalance.Enable.10M"
      },
      "default": true
    },
    {
      "id": "raids-25",
      "type": "boolean",
      "label": {
        "en": "Balance 25-player raids",
        "fr": "Équilibrer les raids à 25"
      },
      "target": {
        "file": "modules/AutoBalance.conf",
        "key": "AutoBalance.Enable.25M"
      },
      "default": true
    },
    {
      "id": "min-players",
      "type": "integer",
      "label": {
        "en": "Balance for at least this many players",
        "fr": "Équilibrer pour au moins ce nombre de joueurs"
      },
      "target": {
        "file": "modules/AutoBalance.conf",
        "key": "AutoBalance.MinPlayers"
      },
      "default": 1,
      "min": 1,
      "max": 40
    },
    {
      "id": "raids-15",
      "type": "boolean",
      "label": { "en": "Balance 15-player raids", "fr": "Équilibrer les raids à 15" },
      "target": { "file": "modules/AutoBalance.conf", "key": "AutoBalance.Enable.15M" },
      "default": true
    },
    {
      "id": "raids-20",
      "type": "boolean",
      "label": { "en": "Balance 20-player raids", "fr": "Équilibrer les raids à 20" },
      "target": { "file": "modules/AutoBalance.conf", "key": "AutoBalance.Enable.20M" },
      "default": true
    },
    {
      "id": "raids-40",
      "type": "boolean",
      "label": { "en": "Balance 40-player raids", "fr": "Équilibrer les raids à 40" },
      "target": { "file": "modules/AutoBalance.conf", "key": "AutoBalance.Enable.40M" },
      "default": true
    },
    {
      "id": "heroic-dungeons",
      "type": "boolean",
      "label": { "en": "Balance heroic dungeons", "fr": "Équilibrer les donjons héroïques" },
      "target": { "file": "modules/AutoBalance.conf", "key": "AutoBalance.Enable.5MHeroic" },
      "default": true
    },
    {
      "id": "heroic-raids-10",
      "type": "boolean",
      "label": {
        "en": "Balance heroic 10-player raids",
        "fr": "Équilibrer les raids héroïques à 10"
      },
      "target": { "file": "modules/AutoBalance.conf", "key": "AutoBalance.Enable.10MHeroic" },
      "default": true
    },
    {
      "id": "heroic-raids-25",
      "type": "boolean",
      "label": {
        "en": "Balance heroic 25-player raids",
        "fr": "Équilibrer les raids héroïques à 25"
      },
      "target": { "file": "modules/AutoBalance.conf", "key": "AutoBalance.Enable.25MHeroic" },
      "default": true
    },
    {
      "id": "min-players-heroic",
      "type": "integer",
      "label": {
        "en": "Heroic dungeons: balance for at least",
        "fr": "Donjons héroïques : équilibrer pour au moins"
      },
      "target": { "file": "modules/AutoBalance.conf", "key": "AutoBalance.MinPlayers.Heroic" },
      "default": 1,
      "min": 1,
      "max": 5
    },
    {
      "id": "min-players-raid",
      "type": "integer",
      "label": { "en": "Raids: balance for at least", "fr": "Raids : équilibrer pour au moins" },
      "target": { "file": "modules/AutoBalance.conf", "key": "AutoBalance.MinPlayers.Raid" },
      "default": 1,
      "min": 1,
      "max": 40
    },
    {
      "id": "difficulty",
      "type": "number",
      "label": {
        "en": "Difficulty of creatures (dungeons)",
        "fr": "Difficulté des créatures (donjons)"
      },
      "target": { "file": "modules/AutoBalance.conf", "key": "AutoBalance.StatModifier.Global" },
      "default": 1.0,
      "min": 0.1,
      "max": 5.0,
      "help": {
        "en": "Multiplies the strength of balanced creatures in 5-player dungeons: 1 = as balanced, 1.5 = harder.",
        "fr": "Multiplie la force des créatures équilibrées des donjons à 5 : 1 = équilibré, 1,5 = plus dur."
      }
    },
    {
      "id": "boss-difficulty",
      "type": "number",
      "label": { "en": "Difficulty of bosses (dungeons)", "fr": "Difficulté des boss (donjons)" },
      "target": {
        "file": "modules/AutoBalance.conf",
        "key": "AutoBalance.StatModifier.Boss.Global"
      },
      "default": 1.0,
      "min": 0.1,
      "max": 5.0
    },
    {
      "id": "level-scaling",
      "type": "boolean",
      "label": {
        "en": "Adjust creature levels to the group",
        "fr": "Ajuster le niveau des créatures au groupe"
      },
      "target": { "file": "modules/AutoBalance.conf", "key": "AutoBalance.LevelScaling" },
      "default": true
    },
    {
      "id": "scale-xp",
      "type": "boolean",
      "label": {
        "en": "Scale experience with difficulty",
        "fr": "Adapter l'expérience à la difficulté"
      },
      "target": { "file": "modules/AutoBalance.conf", "key": "AutoBalance.RewardScaling.XP" },
      "default": true
    },
    {
      "id": "scale-money",
      "type": "boolean",
      "label": { "en": "Scale money with difficulty", "fr": "Adapter l'argent à la difficulté" },
      "target": { "file": "modules/AutoBalance.conf", "key": "AutoBalance.RewardScaling.Money" },
      "default": true
    },
    {
      "id": "notify",
      "type": "boolean",
      "label": {
        "en": "Announce changes in the instance",
        "fr": "Annoncer les changements dans l'instance"
      },
      "target": { "file": "modules/AutoBalance.conf", "key": "AutoBalance.PlayerChangeNotify" },
      "default": true
    }
  ],
  "optionGroups": [
    {
      "id": "instances",
      "label": { "en": "Which instances", "fr": "Quelles instances" },
      "options": [
        "dungeons",
        "heroic-dungeons",
        "raids-10",
        "heroic-raids-10",
        "raids-15",
        "raids-20",
        "raids-25",
        "heroic-raids-25",
        "raids-40"
      ]
    },
    {
      "id": "balance",
      "label": { "en": "How", "fr": "Comment" },
      "options": [
        "min-players",
        "min-players-heroic",
        "min-players-raid",
        "difficulty",
        "boss-difficulty",
        "level-scaling",
        "scale-xp",
        "scale-money",
        "notify"
      ]
    }
  ]
}
