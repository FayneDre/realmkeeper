{
  "$schema": "../../../schema/module.schema.json",
  "schemaVersion": 1,
  "id": "mod-ah-bot",
  "emulator": "azerothcore",
  "name": { "en": "Auction House Bot", "fr": "Bot de l'hôtel des ventes", "de": "Auktionshaus-Bot", "es": "Bot de la casa de subastas" },
  "description": {
    "en": "Fills the auction houses with items and buys player auctions, so the economy feels alive.",
    "fr": "Remplit les hôtels des ventes d'objets et achète les enchères des joueurs pour une économie vivante.",
    "de": "Füllt die Auktionshäuser mit Gegenständen und kauft Auktionen von Spielern, damit die Wirtschaft lebendig wirkt.",
    "es": "Llena las casas de subastas de objetos y compra las subastas de los jugadores para que la economía parezca viva."
  },
  "category": "economy",
  "homepage": "https://github.com/azerothcore/mod-ah-bot",
  "license": "NOASSERTION",
  "source": {
    "repo": "https://github.com/azerothcore/mod-ah-bot",
    "ref": "master",
    "commit": "c11d8318cbd8714a9980f9464f78e07d3d48a70a"
  },
  "compatibleFlavors": ["playerbot"],
  "requires": [],
  "conflicts": [],
  "removable": true,
  "activation": {
    "mode": "config",
    "enable": {
      "modules/mod_ahbot.conf": {
        "AuctionHouseBot.EnableSeller": 1,
        "AuctionHouseBot.EnableBuyer": 1
      }
    },
    "disable": {
      "modules/mod_ahbot.conf": {
        "AuctionHouseBot.EnableSeller": 0,
        "AuctionHouseBot.EnableBuyer": 0
      }
    }
  },
  "database": { "dbimportId": "mod-ah-bot", "applyWhenDisabled": true, "touches": ["world"] },
  "config": {
    "files": [{ "file": "modules/mod_ahbot.conf", "dist": "modules/mod_ahbot.conf.dist" }]
  },
  "options": [
    {
      "id": "seller",
      "type": "boolean",
      "label": { "en": "Bot posts auctions", "fr": "Le bot met des objets en vente", "de": "Bot stellt Auktionen ein", "es": "El bot publica subastas" },
      "target": { "file": "modules/mod_ahbot.conf", "key": "AuctionHouseBot.EnableSeller" },
      "default": true
    },
    {
      "id": "buyer",
      "type": "boolean",
      "label": { "en": "Bot buys player auctions", "fr": "Le bot achète les enchères des joueurs", "de": "Bot kauft Auktionen von Spielern", "es": "El bot compra subastas de jugadores" },
      "target": { "file": "modules/mod_ahbot.conf", "key": "AuctionHouseBot.EnableBuyer" },
      "default": true
    },
    {
      "id": "items-per-cycle",
      "type": "integer",
      "label": { "en": "Items posted per cycle", "fr": "Objets mis en vente par cycle", "de": "Eingestellte Gegenstände pro Durchgang", "es": "Objetos publicados por ciclo" },
      "target": { "file": "modules/mod_ahbot.conf", "key": "AuctionHouseBot.ItemsPerCycle" },
      "default": 200,
      "min": 1,
      "max": 5000,
      "help": {
        "en": "How many auctions the bot adds at most each time it fills an auction house.",
        "fr": "Nombre maximum d'enchères ajoutées chaque fois que le bot remplit un hôtel des ventes.",
        "de": "Wie viele Auktionen der Bot höchstens hinzufügt, wenn er ein Auktionshaus auffüllt.",
        "es": "Cuántas subastas añade el bot como máximo cada vez que llena una casa de subastas."
      }
    },
    {
      "id": "alliance-items",
      "type": "integer",
      "label": {
        "en": "Auctions in the Alliance auction house",
        "fr": "Enchères à l'hôtel des ventes Alliance",
        "de": "Auktionen im Auktionshaus der Allianz",
        "es": "Subastas en la casa de subastas de la Alianza"
      },
      "help": {
        "en": "The bot keeps this many auctions on sale (the module's own default is 250).",
        "fr": "Le bot garde ce nombre d'enchères en vente (250 par défaut dans le module).",
        "de": "Der Bot hält so viele Auktionen im Angebot (Standard des Moduls: 250).",
        "es": "El bot mantiene tantas subastas a la venta (el valor por defecto del módulo es 250)."
      },
      "target": {
        "database": "world",
        "table": "mod_auctionhousebot",
        "column": "maxitems",
        "where": { "auctionhouse": 2 }
      },
      "default": 250,
      "min": 0,
      "max": 20000
    },
    {
      "id": "horde-items",
      "type": "integer",
      "label": {
        "en": "Auctions in the Horde auction house",
        "fr": "Enchères à l'hôtel des ventes Horde",
        "de": "Auktionen im Auktionshaus der Horde",
        "es": "Subastas en la casa de subastas de la Horda"
