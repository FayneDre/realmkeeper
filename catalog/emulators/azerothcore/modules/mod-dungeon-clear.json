{
  "$schema": "../../../schema/module.schema.json",
  "schemaVersion": 1,
  "id": "mod-dungeon-clear",
  "emulator": "azerothcore",
  "name": {
    "en": "Dungeon Clear",
    "fr": "Exploration de donjon"
  },
  "description": {
    "en": "Your group's tank bot leads the way through a dungeon on its own: pulls, bosses, regrouping and resting. Start it inside a dungeon with .dc on.",
    "fr": "Le bot tank de ton groupe mène seul l'exploration d'un donjon : pulls, boss, regroupement et repos. Lance-le dans un donjon avec .dc on."
  },
  "category": "bots",
  "homepage": "https://github.com/jrad7/mod-dungeon-clear",
  "license": "AGPL-3.0",
  "source": {
    "repo": "https://github.com/jrad7/mod-dungeon-clear",
    "ref": "master",
    "commit": "142732c59ce1597e6407ec5a23c6b308a9d4b219"
  },
  "compatibleFlavors": [
    "playerbot"
  ],
  "requires": [
    "mod-playerbots"
  ],
  "conflicts": [],
  "removable": true,
  "activation": {
    "mode": "config",
    "enable": {
      "modules/mod_dungeon_clear.conf": {
        "DungeonClear.Enable": 1
      }
    },
    "disable": {
      "modules/mod_dungeon_clear.conf": {
        "DungeonClear.Enable": 0
      }
    }
  },
  "database": {
    "dbimportId": "mod-dungeon-clear",
    "touches": []
  },
  "config": {
    "files": [
      {
        "file": "modules/mod_dungeon_clear.conf",
        "dist": "modules/mod_dungeon_clear.conf.dist"
      }
    ]
  },
  "options": [
    {
      "id": "clear-room",
      "type": "boolean",
      "label": {
        "en": "Clear the room before each boss",
        "fr": "Nettoyer la salle avant chaque boss"
      },
      "target": {
        "file": "modules/mod_dungeon_clear.conf",
        "key": "DungeonClear.ClearRoomBeforeBoss"
      },
      "default": true
    },
    {
      "id": "ignore-chests",
      "type": "boolean",
      "label": {
        "en": "Ignore chests",
        "fr": "Ignorer les coffres"
      },
      "target": {
        "file": "modules/mod_dungeon_clear.conf",
        "key": "DungeonClear.IgnoreChests"
      },
      "default": true
    },
    {
      "id": "better-loot",
      "type": "boolean",
      "label": {
        "en": "Smarter loot rolls for bots",
        "fr": "Jets de butin plus malins pour les bots"
      },
      "target": {
        "file": "modules/mod_dungeon_clear.conf",
        "key": "DungeonClear.BetterLootRolling"
      },
      "default": false
    },
    {
      "id": "prevent-bot-release",
      "type": "boolean",
      "label": {
        "en": "Dead bots wait for a resurrection in instances",
        "fr": "Les bots morts attendent une résurrection en instance"
      },
      "target": {
        "file": "modules/mod_dungeon_clear.conf",
        "key": "DungeonClear.PreventBotRelease"
      },
      "default": true
    },
    {
      "id": "loot-min-quality",
      "type": "choice",
      "label": { "en": "Loot from", "fr": "Ramasser à partir de" },
      "default": "poor",
      "choices": [
        {
          "id": "poor",
          "label": { "en": "Everything", "fr": "Tout" },
          "config": { "modules/mod_dungeon_clear.conf": { "DungeonClear.LootMinQuality": 0 } }
        },
        {
          "id": "common",
          "label": { "en": "Common (white)", "fr": "Commun (blanc)" },
          "config": { "modules/mod_dungeon_clear.conf": { "DungeonClear.LootMinQuality": 1 } }
        },
        {
          "id": "uncommon",
          "label": { "en": "Uncommon (green)", "fr": "Peu commun (vert)" },
          "config": { "modules/mod_dungeon_clear.conf": { "DungeonClear.LootMinQuality": 2 } }
        },
        {
          "id": "rare",
          "label": { "en": "Rare (blue)", "fr": "Rare (bleu)" },
          "config": { "modules/mod_dungeon_clear.conf": { "DungeonClear.LootMinQuality": 3 } }
        },
        {
          "id": "epic",
          "label": { "en": "Epic (purple)", "fr": "Épique (violet)" },
          "config": { "modules/mod_dungeon_clear.conf": { "DungeonClear.LootMinQuality": 4 } }
        }
      ]
    },
    {
      "id": "smart-rest",
      "type": "boolean",
      "label": { "en": "Fewer, longer rests", "fr": "Repos moins fréquents mais complets" },
      "target": { "file": "modules/mod_dungeon_clear.conf", "key": "DungeonClear.SmartRest" },
      "default": false
    },
    {
      "id": "wait-at-boss",
      "type": "boolean",
      "label": { "en": "Pause before each boss", "fr": "Pause avant chaque boss" },
      "target": { "file": "modules/mod_dungeon_clear.conf", "key": "DungeonClear.WaitAtBoss" },
      "default": false
    },
    {
      "id": "spectate",
      "type": "boolean",
      "label": { "en": "Allow the spectator camera", "fr": "Autoriser la caméra spectateur" },
      "target": { "file": "modules/mod_dungeon_clear.conf", "key": "DungeonClear.SpectateEnable" },
      "default": true
    },
    {
      "id": "queue-fill",
      "type": "boolean",
      "label": {
        "en": "Dungeon Finder: complete the group with bots",
        "fr": "Recherche de donjon : compléter le groupe avec des bots"
      },
      "target": {
        "file": "modules/mod_dungeon_clear.conf",
        "key": "DungeonClear.DungeonQueueFill.Enable"
      },
      "default": false,
      "help": {
        "en": "When you queue, bots of the missing roles queue with you.",
        "fr": "Quand vous vous inscrivez, des bots des rôles manquants s'inscrivent avec vous."
      }
    },
    {
      "id": "queue-fill-auto-clear",
      "type": "boolean",
      "label": {
        "en": "Those bots clear the dungeon themselves",
        "fr": "Ces bots font le donjon eux-mêmes"
      },
      "target": {
        "file": "modules/mod_dungeon_clear.conf",
        "key": "DungeonClear.DungeonQueueFill.AutoClear"
      },
      "default": false
    },
    {
      "id": "bg-queue-fill",
      "type": "boolean",
      "label": {
        "en": "Battlegrounds: complete the teams with bots",
        "fr": "Champs de bataille : compléter les équipes avec des bots"
      },
      "target": {
        "file": "modules/mod_dungeon_clear.conf",
        "key": "DungeonClear.BgQueueFill.Enable"
      },
      "default": false,
      "help": {
        "en": "Turn off \"Random bots join battlegrounds\" in the Bots tab with it, or matches fill twice.",
        "fr": "Désactivez alors « Les bots aléatoires rejoignent champs de bataille » dans l'onglet Bots, sinon les parties se remplissent deux fois."
      }
    }
  ],
  "optionGroups": [
    {
      "id": "run",
      "label": { "en": "During a run", "fr": "Pendant un donjon" },
      "options": [
        "clear-room",
        "ignore-chests",
        "better-loot",
        "loot-min-quality",
        "smart-rest",
        "wait-at-boss",
        "prevent-bot-release",
        "spectate"
      ]
    },
    {
      "id": "queues",
      "label": { "en": "Queues", "fr": "Files d'attente" },
      "options": ["queue-fill", "queue-fill-auto-clear", "bg-queue-fill"]
    }
  ]
}
