{
  "$schema": "../../../schema/module.schema.json",
  "schemaVersion": 1,
  "id": "mod-dungeon-clear",
  "emulator": "azerothcore",
  "name": {
    "en": "Dungeon Clear",
    "fr": "Exploration de donjon",
    "de": "Dungeon Clear",
    "es": "Dungeon Clear"
  },
  "description": {
    "en": "Your group's tank bot leads the way through a dungeon on its own: pulls, bosses, regrouping and resting. Start it inside a dungeon with .dc on.",
    "fr": "Le bot tank de ton groupe mène seul l'exploration d'un donjon : pulls, boss, regroupement et repos. Lance-le dans un donjon avec .dc on.",
    "de": "Der Tank-Bot deiner Gruppe führt euch selbstständig durch einen Dungeon: Pulls, Bosse, Sammeln und Rasten. Starte ihn in einem Dungeon mit .dc on.",
    "es": "El bot tanque de tu grupo abre camino por la mazmorra por su cuenta: pulls, jefes, reagrupación y descanso. Actívalo dentro de una mazmorra con .dc on."
  },
  "category": "bots",
  "homepage": "https://github.com/jrad7/mod-dungeon-clear",
  "license": "AGPL-3.0",
  "source": {
    "repo": "https://github.com/jrad7/mod-dungeon-clear",
    "ref": "master",
    "commit": "142732c59ce1597e6407ec5a23c6b308a9d4b219"
  },
  "compatibleFlavors": [
    "playerbot"
  ],
  "requires": [
    "mod-playerbots"
  ],
  "conflicts": [],
  "removable": true,
  "activation": {
    "mode": "config",
    "enable": {
      "modules/mod_dungeon_clear.conf": {
        "DungeonClear.Enable": 1
      }
    },
    "disable": {
      "modules/mod_dungeon_clear.conf": {
        "DungeonClear.Enable": 0
      }
    }
  },
  "database": {
    "dbimportId": "mod-dungeon-clear",
    "touches": []
  },
  "config": {
    "files": [
      {
        "file": "modules/mod_dungeon_clear.conf",
        "dist": "modules/mod_dungeon_clear.conf.dist"
      }
    ]
  },
  "options": [
    {
      "id": "clear-room",
      "type": "boolean",
      "label": {
        "en": "Clear the room before each boss",
        "fr": "Nettoyer la salle avant chaque boss",
        "de": "Vor jedem Boss den Raum säubern",
        "es": "Limpiar la sala antes de cada jefe"
      },
      "target": {
        "file": "modules/mod_dungeon_clear.conf",
        "key": "DungeonClear.ClearRoomBeforeBoss"
      },
      "default": true
    },
    {
      "id": "ignore-chests",
      "type": "boolean",
      "label": {
        "en": "Ignore chests",
        "fr": "Ignorer les coffres",
        "de": "Truhen ignorieren",
        "es": "Ignorar los cofres"
      },
      "target": {
        "file": "modules/mod_dungeon_clear.conf",
        "key": "DungeonClear.IgnoreChests"
      },
      "default": true
    },
    {
      "id": "better-loot",
      "type": "boolean",
      "label": {
        "en": "Smarter loot rolls for bots",
        "fr": "Jets de butin plus malins pour les bots",
        "de": "Klügere Würfe der Bots um Beute",
        "es": "Tiradas de botín más inteligentes para los bots"
      },
      "target": {
        "file": "modules/mod_dungeon_clear.conf",
        "key": "DungeonClear.BetterLootRolling"
      },
      "default": false
    },
    {
      "id": "prevent-bot-release",
      "type": "boolean",
      "label": {
        "en": "Dead bots wait for a resurrection in instances",
        "fr": "Les bots morts attendent une résurrection en instance",
        "de": "Tote Bots warten in Instanzen auf eine Wiederbelebung",
        "es": "Los bots muertos esperan una resurrección en las instancias"
      },
      "target": {
        "file": "modules/mod_dungeon_clear.conf",
        "key": "DungeonClear.PreventBotRelease"
      },
      "default": true
    },
    {
      "id": "loot-min-quality",
      "type": "choice",
      "label": { "en": "Loot from", "fr": "Ramasser à partir de", "de": "Beute ab", "es": "Botín a partir de" },
      "default": "poor",
      "choices": [
        {
          "id": "poor",
          "label": { "en": "Everything", "fr": "Tout", "de": "Alles", "es": "Todo" },
          "config": { "modules/mod_dungeon_clear.conf": { "DungeonClear.LootMinQuality": 0 } }
        },
        {
          "id": "common",
          "label": { "en": "Common (white)", "fr": "Commun (blanc)", "de": "Gewöhnlich (weiß)", "es": "Común (blanco)" },
          "config": { "modules/mod_dungeon_clear.conf": { "DungeonClear.LootMinQuality": 1 } }
        },
        {
          "id": "uncommon",
          "label": { "en": "Uncommon (green)", "fr": "Peu commun (vert)", "de": "Selten (grün)", "es": "Poco común (verde)" },
          "config": { "modules/mod_dungeon_clear.conf": { "DungeonClear.LootMinQuality": 2 } }
        },
        {
          "id": "rare",
          "label": { "en": "Rare (blue)", "fr": "Rare (bleu)", "de": "Rar (blau)", "es": "Raro (azul)" },
          "config": { "modules/mod_dungeon_clear.conf": { "DungeonClear.LootMinQuality": 3 } }
        },
        {
          "id": "epic",
          "label": { "en": "Epic (purple)", "fr": "Épique (violet)", "de": "Episch (lila)", "es": "Épico (morado)" },
          "config": { "modules/mod_dungeon_clear.conf": { "DungeonClear.LootMinQuality": 4 } }
        }
      ]
    },
    {
      "id": "smart-rest",
      "type": "boolean",
      "label": { "en": "Fewer, longer rests", "fr": "Repos moins fréquents mais complets", "de": "Weniger, längere Pausen", "es": "Menos descansos, pero más largos" },
      "target": { "file": "modules/mod_dungeon_clear.conf", "key": "DungeonClear.SmartRest" },
      "default": false
    },
    {
      "id": "wait-at-boss",
      "type": "boolean",
      "label": { "en": "Pause before each boss", "fr": "Pause avant chaque boss", "de": "Pause vor jedem Boss", "es": "Pausa antes de cada jefe" },
      "target": { "file": "modules/mod_dungeon_clear.conf", "key": "DungeonClear.WaitAtBoss" },
      "default": false
    },
    {
      "id": "spectate",
      "type": "boolean",
      "label": { "en": "Allow the spectator camera", "fr": "Autoriser la caméra spectateur", "de": "Zuschauerkamera erlauben", "es": "Permitir la cámara de espectador" },
      "target": { "file": "modules/mod_dungeon_clear.conf", "key": "DungeonClear.SpectateEnable" },
      "default": true
    },
    {
      "id": "queue-fill",
      "type": "boolean",
      "label": {
        "en": "Dungeon Finder: complete the group with bots",
        "fr": "Recherche de donjon : compléter le groupe avec des bots",
        "de": "Dungeonbrowser: Gruppe mit Bots auffüllen",
        "es": "Buscador de mazmorras: completar el grupo con bots"
      },
      "target": {
        "file": "modules/mod_dungeon_clear.conf",
        "key": "DungeonClear.DungeonQueueFill.Enable"
      },
      "default": false,
      "help": {
        "en": "When you queue, bots of the missing roles queue with you.",
        "fr": "Quand vous vous inscrivez, des bots des rôles manquants s'inscrivent avec vous.",
        "de": "Wenn du dich anmeldest, melden sich Bots der fehlenden Rollen mit dir an.",
        "es": "Cuando te apuntas, bots de los roles que faltan se apuntan contigo."
      }
    },
    {
      "id": "queue-fill-auto-clear",
      "type": "boolean",
      "label": {
        "en": "Those bots clear the dungeon themselves",
        "fr": "Ces bots font le donjon eux-mêmes",
        "de": "Diese Bots säubern den Dungeon selbst",
        "es": "Esos bots limpian la mazmorra por sí mismos"
      },
      "target": {
        "file": "modules/mod_dungeon_clear.conf",
        "key": "DungeonClear.DungeonQueueFill.AutoClear"
      },
      "default": false
    },
    {
      "id": "bg-queue-fill",
      "type": "boolean",
      "label": {
        "en": "Battlegrounds: complete the teams with bots",
        "fr": "Champs de bataille : compléter les équipes avec des bots",
        "de": "Schlachtfelder: Teams mit Bots auffüllen",
        "es": "Campos de batalla: completar los equipos con bots"
      },
      "target": {
        "file": "modules/mod_dungeon_clear.conf",
        "key": "DungeonClear.BgQueueFill.Enable"
      },
      "default": false,
      "help": {
        "en": "Turn off \"Random bots join battlegrounds\" in the Bots tab with it, or matches fill twice.",
        "fr": "Désactivez alors « Les bots aléatoires rejoignent champs de bataille » dans l'onglet Bots, sinon les parties se remplissent deux fois.",
        "de": "Schalte dabei „Zufallsbots treten Schlachtfeldern bei“ im Reiter „Bots“ aus, sonst werden die Partien doppelt aufgefüllt.",
        "es": "Desactiva a la vez «Los bots aleatorios se unen a los campos de batalla» en la pestaña Bots, o las partidas se llenarán dos veces."
      }
    }
  ],
  "optionGroups": [
    {
      "id": "run",
      "label": { "en": "During a run", "fr": "Pendant un donjon", "de": "Während eines Durchlaufs", "es": "Durante una incursión" },
      "options": [
        "clear-room",
        "ignore-chests",
        "better-loot",
        "loot-min-quality",
        "smart-rest",
        "wait-at-boss",
        "prevent-bot-release",
        "spectate"
      ]
    },
    {
      "id": "queues",
      "label": { "en": "Queues", "fr": "Files d'attente", "de": "Warteschlangen", "es": "Colas" },
      "options": ["queue-fill", "queue-fill-auto-clear", "bg-queue-fill"]
    }
  ]
}
