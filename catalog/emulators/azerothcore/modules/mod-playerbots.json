{
  "$schema": "../../../schema/module.schema.json",
  "schemaVersion": 1,
  "id": "mod-playerbots",
  "emulator": "azerothcore",
  "name": {
    "en": "Playerbots",
    "fr": "Playerbots"
  },
  "description": {
    "en": "AI-controlled player characters that quest, group, run dungeons and populate the world.",
    "fr": "Personnages joueurs contrôlés par l'IA qui font des quêtes, se groupent, font des donjons et peuplent le monde."
  },
  "category": "bots",
  "homepage": "https://github.com/mod-playerbots/mod-playerbots",
  "license": "GPL-2.0",
  "source": {
    "repo": "https://github.com/mod-playerbots/mod-playerbots",
    "ref": "master",
    "commit": "405f81196161017eebae3ee7a612d786a3ed2a9d"
  },
  "compatibleFlavors": [
    "playerbot"
  ],
  "requires": [],
  "conflicts": [],
  "removable": false,
  "activation": {
    "mode": "always"
  },
  "database": {
    "dbimportId": "mod-playerbots",
    "touches": [
      "characters",
      "world",
      "playerbots"
    ],
    "extraDatabases": [
      {
        "id": "playerbots",
        "name": "acore_playerbots",
        "playerData": true,
        "connections": [
          {
            "file": "modules/playerbots.conf",
            "key": "PlayerbotsDatabaseInfo"
          }
        ]
      }
    ]
  },
  "config": {
    "files": [
      {
        "file": "modules/playerbots.conf",
        "dist": "modules/playerbots.conf.dist"
      }
    ]
  },
  "options": [
    {
      "id": "random-bot-autologin",
      "type": "boolean",
      "label": {
        "en": "Random bots in the world",
        "fr": "Bots aléatoires dans le monde"
      },
      "help": {
        "en": "Bots that live their own lives: questing, grouping, trading.",
        "fr": "Des bots qui vivent leur vie : quêtes, groupes, échanges."
      },
      "target": {
        "file": "modules/playerbots.conf",
        "key": "Playerbots.RandomBotAutologin"
      },
      "default": true
    },
    {
      "id": "min-random-bots",
      "type": "integer",
      "label": {
        "en": "Minimum random bots",
        "fr": "Nombre minimum de bots aléatoires"
      },
      "help": {
        "en": "At each server start, the number of bots online is drawn at random between the minimum and the maximum. Set both to the same value for a fixed number.",
        "fr": "À chaque démarrage du serveur, le nombre de bots en ligne est tiré au hasard entre le minimum et le maximum. Mets la même valeur aux deux pour un nombre fixe."
      },
      "target": {
        "file": "modules/playerbots.conf",
        "key": "Playerbots.MinRandomBots"
      },
      "default": 500,
      "min": 0,
      "max": 5000
    },
    {
      "id": "max-random-bots",
      "type": "integer",
      "label": {
        "en": "Maximum random bots",
        "fr": "Nombre maximum de bots aléatoires"
      },
      "help": {
        "en": "At each server start, the number of bots online is drawn at random between the minimum and the maximum. Set both to the same value for a fixed number.",
        "fr": "À chaque démarrage du serveur, le nombre de bots en ligne est tiré au hasard entre le minimum et le maximum. Mets la même valeur aux deux pour un nombre fixe."
      },
      "target": {
        "file": "modules/playerbots.conf",
        "key": "Playerbots.MaxRandomBots"
      },
      "default": 500,
      "min": 0,
      "max": 5000
    },
    {
      "id": "random-bot-min-level",
      "type": "integer",
      "label": {
        "en": "Lowest random bot level",
        "fr": "Niveau minimum des bots aléatoires"
      },
      "target": {
        "file": "modules/playerbots.conf",
        "key": "Playerbots.RandomBotMinLevel"
      },
      "default": 1,
      "min": 1,
      "max": 80
    },
    {
      "id": "random-bot-max-level",
      "type": "integer",
      "label": {
        "en": "Highest random bot level",
        "fr": "Niveau maximum des bots aléatoires"
      },
      "target": {
        "file": "modules/playerbots.conf",
        "key": "Playerbots.RandomBotMaxLevel"
      },
      "default": 80,
      "min": 1,
      "max": 80
    },
    {
      "id": "sync-level-with-players",
      "type": "boolean",
      "label": {
        "en": "Random bots follow the players' level",
        "fr": "Les bots aléatoires suivent le niveau des joueurs"
      },
      "help": {
        "en": "Caps the random bot level at the highest level of the players online.",
        "fr": "Limite le niveau des bots aléatoires au plus haut niveau des joueurs connectés."
      },
      "target": {
        "file": "modules/playerbots.conf",
        "key": "Playerbots.SyncLevelWithPlayers"
      },
      "default": false
    },
    {
      "id": "max-added-bots",
      "type": "integer",
      "label": {
        "en": "Bots a player can control",
        "fr": "Bots qu'un joueur peut contrôler"
      },
      "help": {
        "en": "How many bots one player can add to their group or command at once.",
        "fr": "Combien de bots un joueur peut ajouter à son groupe ou commander à la fois."
      },
      "target": {
        "file": "modules/playerbots.conf",
        "key": "Playerbots.MaxAddedBots"
      },
      "default": 40,
      "min": 0,
      "max": 1000
    },
    {
      "id": "random-bot-join-lfg",
      "type": "boolean",
      "label": {
        "en": "Random bots use the dungeon finder",
        "fr": "Les bots aléatoires utilisent la recherche de donjon"
      },
      "target": {
        "file": "modules/playerbots.conf",
        "key": "Playerbots.RandomBotJoinLfg"
      },
      "default": true
    },
    {
      "id": "random-bot-join-bg",
      "type": "boolean",
      "label": {
        "en": "Random bots join battlegrounds and arenas",
        "fr": "Les bots aléatoires rejoignent champs de bataille et arènes"
      },
      "target": {
        "file": "modules/playerbots.conf",
        "key": "Playerbots.RandomBotJoinBG"
      },
      "default": true
    },
    {
      "id": "random-bot-auto-join-bg",
      "type": "boolean",
      "label": {
        "en": "Random bots start battlegrounds on their own",
        "fr": "Les bots aléatoires lancent des champs de bataille d'eux-mêmes"
      },
      "target": {
        "file": "modules/playerbots.conf",
        "key": "Playerbots.RandomBotAutoJoinBG"
      },
      "default": false
    },
    {
      "id": "random-bot-guild-count",
      "type": "integer",
      "label": {
        "en": "Guilds of random bots",
        "fr": "Guildes de bots aléatoires"
      },
      "target": {
        "file": "modules/playerbots.conf",
        "key": "Playerbots.RandomBotGuildCount"
      },
      "default": 20,
      "min": 0,
      "max": 1000
    },
    {
      "id": "random-bot-talk",
      "type": "boolean",
      "label": {
        "en": "Random bots talk in chat",
        "fr": "Les bots aléatoires parlent dans le chat"
      },
      "target": {
        "file": "modules/playerbots.conf",
        "key": "Playerbots.RandomBotTalk"
      },
      "default": true
    },
    {
      "id": "enable-broadcasts",
      "type": "boolean",
      "label": {
        "en": "Random bots announce their deeds",
        "fr": "Les bots aléatoires annoncent leurs exploits"
      },
      "help": {
        "en": "Loot, quest and level-up messages in the general and guild channels.",
        "fr": "Messages de butin, de quêtes et de niveaux dans les canaux général et de guilde."
      },
      "target": {
        "file": "modules/playerbots.conf",
        "key": "Playerbots.EnableBroadcasts"
      },
      "default": true
    },
    {
      "id": "multibot-addon",
      "type": "choice",
      "label": {
        "en": "MultiBot add-on in the game",
        "fr": "Add-on MultiBot dans le jeu"
      },
      "help": {
        "en": "Buttons to command your bots in the game instead of typing chat commands (MultiBot by Macx-Lio, GPL-3.0). Installed in Interface/AddOns, removed when turned off.",
        "fr": "Des boutons pour commander tes bots dans le jeu au lieu de taper des commandes dans le chat (MultiBot de Macx-Lio, GPL-3.0). Installé dans Interface/AddOns, retiré une fois désactivé."
      },
      "default": "off",
      "choices": [
        {
          "id": "off",
          "label": {
            "en": "Off",
            "fr": "Désactivé"
          }
        },
        {
          "id": "on",
          "label": {
            "en": "On",
            "fr": "Activé"
          },
          "assets": [
            "multibot"
          ]
        }
      ]
    },
    {
      "id": "random-bot-fixed-level",
      "type": "boolean",
      "label": {
        "en": "Random bots never level up",
        "fr": "Les bots aléatoires ne montent jamais de niveau"
      },
      "target": { "file": "modules/playerbots.conf", "key": "Playerbots.RandomBotFixedLevel" },
      "default": false
    },
    {
      "id": "disable-death-knights",
      "type": "boolean",
      "label": {
        "en": "No Death Knight random bots",
        "fr": "Pas de bots aléatoires chevaliers de la mort"
      },
      "target": { "file": "modules/playerbots.conf", "key": "Playerbots.DisableDeathKnightLogin" },
      "default": false
    },
    {
      "id": "random-gear-quality",
      "type": "choice",
      "label": {
        "en": "Best gear of random bots",
        "fr": "Meilleur équipement des bots aléatoires"
      },
      "default": "rare",
      "choices": [
        {
          "id": "common",
          "label": { "en": "Common (white)", "fr": "Commun (blanc)" },
          "config": { "modules/playerbots.conf": { "Playerbots.RandomGearQualityLimit": 1 } }
        },
        {
          "id": "uncommon",
          "label": { "en": "Uncommon (green)", "fr": "Peu commun (vert)" },
          "config": { "modules/playerbots.conf": { "Playerbots.RandomGearQualityLimit": 2 } }
        },
        {
          "id": "rare",
          "label": { "en": "Rare (blue)", "fr": "Rare (bleu)" },
          "config": { "modules/playerbots.conf": { "Playerbots.RandomGearQualityLimit": 3 } }
        },
        {
          "id": "epic",
          "label": { "en": "Epic (purple)", "fr": "Épique (violet)" },
          "config": { "modules/playerbots.conf": { "Playerbots.RandomGearQualityLimit": 4 } }
        },
        {
          "id": "legendary",
          "label": { "en": "Legendary (orange)", "fr": "Légendaire (orange)" },
          "config": { "modules/playerbots.conf": { "Playerbots.RandomGearQualityLimit": 5 } }
        }
      ]
    },
    {
      "id": "allow-account-bots",
      "type": "boolean",
      "label": {
        "en": "Your other characters can be your bots",
        "fr": "Vos autres personnages peuvent être vos bots"
      },
      "target": { "file": "modules/playerbots.conf", "key": "Playerbots.AllowAccountBots" },
      "default": true
    },
    {
      "id": "allow-guild-bots",
      "type": "boolean",
      "label": {
        "en": "Guild members' characters can be your bots",
        "fr": "Les personnages de la guilde peuvent être vos bots"
      },
      "target": { "file": "modules/playerbots.conf", "key": "Playerbots.AllowGuildBots" },
      "default": true
    },
    {
      "id": "auto-equip-upgrades",
      "type": "boolean",
      "label": {
        "en": "Your bots equip the upgrades they loot",
        "fr": "Vos bots s'équipent des améliorations qu'ils ramassent"
      },
      "target": { "file": "modules/playerbots.conf", "key": "Playerbots.AutoEquipUpgradeLoot" },
      "default": true
    },
    {
      "id": "autogear-quality",
      "type": "choice",
      "label": {
        "en": "Best gear of the \"autogear\" command",
        "fr": "Meilleur équipement de la commande « autogear »"
      },
      "default": "rare",
      "choices": [
        {
          "id": "common",
          "label": { "en": "Common (white)", "fr": "Commun (blanc)" },
          "config": { "modules/playerbots.conf": { "Playerbots.AutoGearQualityLimit": 1 } }
        },
        {
          "id": "uncommon",
          "label": { "en": "Uncommon (green)", "fr": "Peu commun (vert)" },
          "config": { "modules/playerbots.conf": { "Playerbots.AutoGearQualityLimit": 2 } }
        },
        {
          "id": "rare",
          "label": { "en": "Rare (blue)", "fr": "Rare (bleu)" },
          "config": { "modules/playerbots.conf": { "Playerbots.AutoGearQualityLimit": 3 } }
        },
        {
          "id": "epic",
          "label": { "en": "Epic (purple)", "fr": "Épique (violet)" },
          "config": { "modules/playerbots.conf": { "Playerbots.AutoGearQualityLimit": 4 } }
        },
        {
          "id": "legendary",
          "label": { "en": "Legendary (orange)", "fr": "Légendaire (orange)" },
          "config": { "modules/playerbots.conf": { "Playerbots.AutoGearQualityLimit": 5 } }
        }
      ]
    },
    {
      "id": "sync-quests",
      "type": "boolean",
      "label": {
        "en": "Your bots complete quests with you",
        "fr": "Vos bots terminent les quêtes avec vous"
      },
      "target": { "file": "modules/playerbots.conf", "key": "Playerbots.SyncQuestWithPlayer" },
      "default": true
    },
    {
      "id": "summon-in-combat",
      "type": "boolean",
      "label": {
        "en": "Summon your bots during a fight",
        "fr": "Invoquer vos bots pendant un combat"
      },
      "target": { "file": "modules/playerbots.conf", "key": "Playerbots.AllowSummonInCombat" },
      "default": true
    },
    {
      "id": "revive-when-summoned",
      "type": "choice",
      "label": {
        "en": "Revive bots when summoning them",
        "fr": "Ressusciter les bots en les invoquant"
      },
      "default": "out-of-combat",
      "choices": [
        {
          "id": "never",
          "label": { "en": "Never", "fr": "Jamais" },
          "config": { "modules/playerbots.conf": { "Playerbots.ReviveBotWhenSummoned": 0 } }
        },
        {
          "id": "out-of-combat",
          "label": { "en": "Out of combat", "fr": "Hors combat" },
          "config": { "modules/playerbots.conf": { "Playerbots.ReviveBotWhenSummoned": 1 } }
        },
        {
          "id": "always",
          "label": { "en": "Always", "fr": "Toujours" },
          "config": { "modules/playerbots.conf": { "Playerbots.ReviveBotWhenSummoned": 2 } }
        }
      ]
    },
    {
      "id": "loot-need",
      "type": "choice",
      "label": {
        "en": "Bots roll on items they need",
        "fr": "Les bots lancent les dés sur les objets utiles"
      },
      "default": "greed",
      "choices": [
        {
          "id": "pass",
          "label": { "en": "Pass", "fr": "Passer" },
          "config": { "modules/playerbots.conf": { "Playerbots.LootNeedRollLevel": 0 } }
        },
        {
          "id": "greed",
          "label": { "en": "Greed", "fr": "Cupidité" },
          "config": { "modules/playerbots.conf": { "Playerbots.LootNeedRollLevel": 1 } }
        },
        {
          "id": "need",
          "label": { "en": "Need", "fr": "Besoin" },
          "config": { "modules/playerbots.conf": { "Playerbots.LootNeedRollLevel": 2 } }
        }
      ]
    },
    {
      "id": "loot-greed",
      "type": "boolean",
      "label": {
        "en": "Bots roll Greed on other items",
        "fr": "Les bots lancent Cupidité sur les autres objets"
      },
      "target": { "file": "modules/playerbots.conf", "key": "Playerbots.LootGreedRollLevel" },
      "default": false
    },
    {
      "id": "loot-recipes",
      "type": "boolean",
      "label": {
        "en": "Bots roll on recipes they can learn",
        "fr": "Les bots lancent les dés sur les recettes qu'ils peuvent apprendre"
      },
      "target": { "file": "modules/playerbots.conf", "key": "Playerbots.LootRollRecipe" },
      "default": false
    },
    {
      "id": "loot-disenchant",
      "type": "boolean",
      "label": {
        "en": "Enchanter bots roll Disenchant",
        "fr": "Les bots enchanteurs lancent Désenchanter"
      },
      "target": { "file": "modules/playerbots.conf", "key": "Playerbots.LootRollDisenchant" },
      "default": false
    }
  ],
  "optionGroups": [
    {
      "id": "world",
      "label": { "en": "Random bots in the world", "fr": "Bots aléatoires dans le monde" },
      "options": [
        "random-bot-autologin",
        "min-random-bots",
        "max-random-bots",
        "random-bot-min-level",
        "random-bot-max-level",
        "sync-level-with-players",
        "random-bot-fixed-level",
        "disable-death-knights",
        "random-gear-quality",
        "random-bot-guild-count"
      ]
    },
    {
      "id": "activities",
      "label": { "en": "What random bots do", "fr": "Ce que font les bots aléatoires" },
      "options": [
        "random-bot-join-lfg",
        "random-bot-join-bg",
        "random-bot-auto-join-bg",
        "random-bot-talk",
        "enable-broadcasts"
      ]
    },
    {
      "id": "yours",
      "label": { "en": "Your bots", "fr": "Vos bots" },
      "options": [
        "max-added-bots",
        "allow-account-bots",
        "allow-guild-bots",
        "auto-equip-upgrades",
        "autogear-quality",
        "sync-quests",
        "summon-in-combat",
        "revive-when-summoned"
      ]
    },
    {
      "id": "loot",
      "label": { "en": "Loot rolls", "fr": "Jets de butin" },
      "options": ["loot-need", "loot-greed", "loot-recipes", "loot-disenchant"]
    }
  ],
  "assets": [
    {
      "id": "multibot",
      "source": {
        "repository": "https://github.com/Macx-Lio/MultiBot",
        "commit": "ecee413dacfa93ee705ede83f308f3a0396e6ece",
        "size": 31071059,
        "sha256": "b022d405e663269daa523a421ed5baa61ee58fa6bb880500759c5f005a529ef6"
      },
      "addons": [
        {
          "from": "MultiBot-ecee413dacfa93ee705ede83f308f3a0396e6ece",
          "to": "MultiBot"
        }
      ]
    }
  ]
}
