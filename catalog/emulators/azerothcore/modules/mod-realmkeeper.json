{
  "$schema": "../../../schema/module.schema.json",
  "schemaVersion": 1,
  "id": "mod-realmkeeper",
  "emulator": "azerothcore",
  "name": {
    "en": "RealmKeeper party",
    "fr": "Groupe RealmKeeper",
    "de": "RealmKeeper-Gruppe",
    "es": "Grupo RealmKeeper"
  },
  "description": {
    "en": "Lets the launcher form a party of bots for the character you play: role, class, spec and level of each bot.",
    "fr": "Permet au launcher de former un groupe de bots pour le personnage que tu joues : rôle, classe, spé et niveau de chaque bot.",
    "de": "Ermöglicht dem Launcher, eine Bot-Gruppe für den Charakter zu bilden, den du spielst: Rolle, Klasse, Spezialisierung und Stufe jedes Bots.",
    "es": "Permite al launcher formar un grupo de bots para el personaje con el que juegas: rol, clase, especialización y nivel de cada bot."
  },
  "category": "bots",
  "homepage": "https://github.com/FayneDre/mod-realmkeeper",
  "license": "GPL-2.0-or-later",
  "source": {
    "repo": "https://github.com/FayneDre/mod-realmkeeper",
    "ref": "main",
    "commit": "a267de088a61499ffe15bee7db4f0a8bff8ace29"
  },
  "compatibleFlavors": [
    "playerbot"
  ],
  "requires": [
    "mod-playerbots"
  ],
  "conflicts": [],
  "removable": false,
  "activation": {
    "mode": "always"
  },
  "database": {
    "dbimportId": "mod-realmkeeper",
    "touches": []
  },
  "config": {
    "files": [
      {
        "file": "modules/mod_realmkeeper.conf",
        "dist": "modules/mod_realmkeeper.conf.dist"
      }
    ]
  },
  "options": [
    {
      "id": "party-gear-quality",
      "type": "choice",
      "label": { "en": "Gear of party bots", "fr": "Équipement des bots du groupe", "de": "Ausrüstung der Gruppen-Bots", "es": "Equipo de los bots del grupo" },
      "default": "rare",
      "choices": [
        {
          "id": "uncommon",
          "label": { "en": "Uncommon (green)", "fr": "Peu commun (vert)", "de": "Selten (grün)", "es": "Poco común (verde)" },
          "config": { "modules/mod_realmkeeper.conf": { "RealmKeeper.Party.GearQuality": 2 } }
        },
        {
          "id": "rare",
          "label": { "en": "Rare (blue)", "fr": "Rare (bleu)", "de": "Rar (blau)", "es": "Raro (azul)" },
          "config": { "modules/mod_realmkeeper.conf": { "RealmKeeper.Party.GearQuality": 3 } }
        },
        {
          "id": "epic",
          "label": { "en": "Epic (purple)", "fr": "Épique (violet)", "de": "Episch (lila)", "es": "Épico (morado)" },
          "config": { "modules/mod_realmkeeper.conf": { "RealmKeeper.Party.GearQuality": 4 } }
        }
      ]
    },
    {
      "id": "party-gear-lowering",
      "type": "number",
      "label": {
        "en": "Share of pieces one quality lower",
        "fr": "Part des pièces d'une qualité en dessous",
        "de": "Anteil der Teile eine Qualitätsstufe niedriger",
        "es": "Proporción de piezas de una calidad inferior"
      },
      "target": {
        "file": "modules/mod_realmkeeper.conf",
        "key": "RealmKeeper.Party.GearLoweringChance"
      },
      "default": 0.35,
      "min": 0.0,
      "max": 1.0,
      "help": {
        "en": "0 = every piece of the chosen quality, 0.35 = about a third one quality lower.",
        "fr": "0 = toutes les pièces de la qualité choisie, 0,35 = environ un tiers d'une qualité en dessous.",
        "de": "0 = jedes Teil in der gewählten Qualität, 0,35 = etwa ein Drittel eine Stufe niedriger.",
        "es": "0 = todas las piezas de la calidad elegida, 0,35 = alrededor de un tercio de una calidad inferior."
      }
    },
    {
      "id": "server-channel-names",
      "type": "boolean",
      "label": {
        "en": "Same General and Trade channels as the bots",
        "fr": "Mêmes canaux Général et Commerce que les bots",
        "de": "Dieselben Kanäle „Allgemein“ und „Handel“ wie die Bots",
        "es": "Mismos canales General y Comercio que los bots"
      },
      "target": {
        "file": "modules/mod_realmkeeper.conf",
        "key": "RealmKeeper.Channels.ServerNames"
      },
      "default": true,
      "help": {
        "en": "A game in another language than the server joins the bots' channels.",
        "fr": "Un jeu dans une autre langue que le serveur rejoint les canaux des bots.",
        "de": "Ein Spiel in einer anderen Sprache als der Server tritt den Kanälen der Bots bei.",
        "es": "Un juego en otro idioma que el servidor se une a los canales de los bots."
      }
    }
  ],
  "party": {
    "size": 5,
    "commands": {
      "add": ".rk party add {player} {class} {spec} {level}",
