{
  "$schema": "../../schema/emulator.schema.json",
  "schemaVersion": 1,
  "id": "azerothcore",
  "name": "AzerothCore",
  "description": {
    "en": "Open-source World of Warcraft: Wrath of the Lich King (3.3.5a) server emulator.",
    "fr": "Émulateur de serveur open source pour World of Warcraft: Wrath of the Lich King (3.3.5a).",
    "de": "Open-Source-Serveremulator für World of Warcraft: Wrath of the Lich King (3.3.5a).",
    "es": "Emulador de servidor de código abierto de World of Warcraft: Wrath of the Lich King (3.3.5a)."
  },
  "homepage": "https://www.azerothcore.org",
  "license": "GPL-2.0",
  "driver": "azerothcore",
  "client": "wow-3-3-5a",
  "components": [
    { "id": "mysql-8-4" }
  ],
  "defaultFlavor": "playerbot",
  "databases": [
    {
      "id": "auth",
      "name": "acore_auth",
      "playerData": true,
      "realmTables": ["realmlist"],
      "connections": [
        { "file": "authserver.conf", "key": "LoginDatabaseInfo" },
        { "file": "worldserver.conf", "key": "LoginDatabaseInfo" },
        { "file": "dbimport.conf", "key": "LoginDatabaseInfo" }
      ]
    },
    {
      "id": "characters",
      "name": "acore_characters",
      "playerData": true,
      "connections": [
        { "file": "worldserver.conf", "key": "CharacterDatabaseInfo" },
        { "file": "dbimport.conf", "key": "CharacterDatabaseInfo" }
      ]
    },
    {
      "id": "world",
      "name": "acore_world",
      "playerData": false,
      "connections": [
        { "file": "worldserver.conf", "key": "WorldDatabaseInfo" },
        { "file": "dbimport.conf", "key": "WorldDatabaseInfo" }
      ]
    }
  ],
  "instance": {
    "diskSize": 2856909827,
    "connection": "127.0.0.1;${db.port};${db.user};${db.password};${db.name}",
    "config": {
      "authserver.conf": {
        "LogsDir": "${dir.logs}",
        "SourceDirectory": "${dir.sql}",
        "MySQLExecutable": "${tool.mysql}",
        "RealmServerPort": "${port.auth}",
        "BindIP": "${network.bind}",
        "Updates.EnableDatabases": 0
      },
      "dbimport.conf": {
        "LogsDir": "${dir.logs}",
        "SourceDirectory": "${dir.sql}",
        "MySQLExecutable": "${tool.mysql}",
        "Updates.AllowedModules": "${modules.dbimport}"
      },
      "worldserver.conf": {
        "DataDir": "${dir.data}",
        "LogsDir": "${dir.logs}",
        "SourceDirectory": "${dir.sql}",
        "MySQLExecutable": "${tool.mysql}",
        "WorldServerPort": "${port.world}",
        "BindIP": "${network.bind}",
        "SOAP.Port": "${port.soap}",
        "Updates.EnableDatabases": 0
      }
    },
    "dbImport": { "executable": "bin/dbimport", "configFile": "dbimport.conf" },
    "optionalSql": {
      "source": "modules/{module}/{file}",
      "target": "modules/{module}/data/sql/db-{database}/rk-optional"
    }
  },
  "ports": {
    "auth": 3724,
    "world": 8085,
    "soap": 7878
  },
  "processes": [
    {
      "id": "authserver",
      "executable": "bin/authserver",
      "configFile": "authserver.conf",
      "args": ["-c", "configs/authserver.conf"],
      "readiness": { "type": "tcp", "port": "auth" },
      "stop": { "type": "terminate" }
    },
    {
      "id": "worldserver",
      "executable": "bin/worldserver",
      "configFile": "worldserver.conf",
      "args": ["-c", "configs/worldserver.conf"],
      "readiness": { "type": "tcp", "port": "world" },
      "stop": { "type": "close-stdin", "timeoutSeconds": 600 },
      "startup": [
        {
          "match": "Loading World Information...",
          "progress": 0.02,
          "label": {
            "en": "Loading the world",
            "fr": "Chargement du monde",
            "de": "Welt wird geladen",
            "es": "Cargando el mundo"
          }
        },
        {
          "match": "Loading SpellInfo Store...",
          "progress": 0.05,
          "label": {
            "en": "Loading spells",
            "fr": "Chargement des sorts",
            "de": "Zauber werden geladen",
            "es": "Cargando los hechizos"
          }
        },
        {
          "match": "Loading Items...",
          "progress": 0.08,
          "label": {
            "en": "Loading items",
            "fr": "Chargement des objets",
            "de": "Gegenstände werden geladen",
            "es": "Cargando los objetos"
          }
        },
        {
          "match": "Loading Creature Data...",
          "progress": 0.11,
          "label": {
            "en": "Loading creatures",
            "fr": "Chargement des créatures",
            "de": "Kreaturen werden geladen",
            "es": "Cargando las criaturas"
          }
        },
        {
          "match": "Loading Quests...",
          "progress": 0.14,
          "label": {
            "en": "Loading quests",
            "fr": "Chargement des quêtes",
            "de": "Quests werden geladen",
            "es": "Cargando las misiones"
          }
        },
        {
          "match": "Starting Map System",
          "progress": 0.17,
          "label": {
            "en": "Starting the maps",
            "fr": "Démarrage des cartes",
            "de": "Karten werden gestartet",
            "es": "Iniciando los mapas"
          }
        },
        {
          "match": "Loading Transports...",
          "progress": 0.19,
          "label": {
            "en": "Loading boats and zeppelins",
            "fr": "Chargement des bateaux et zeppelins",
            "de": "Schiffe und Zeppeline werden geladen",
            "es": "Cargando barcos y zepelines"
          }
        },
        {
          "match": "Load Playerbots Config...",
          "progress": 0.24,
          "label": {
            "en": "Preparing the bots",
            "fr": "Préparation des bots",
            "de": "Bots werden vorbereitet",
            "es": "Preparando los bots"
          }
        },
        {
          "match": "Building equipment cache",
          "progress": 0.8,
          "label": {
            "en": "Equipping the bots",
            "fr": "Équipement des bots",
            "de": "Bots werden ausgerüstet",
            "es": "Equipando a los bots"
          }
        },
        {
          "match": "mod-playerbots initialized",
          "progress": 0.95,
          "label": {
            "en": "Bots ready",
            "fr": "Bots prêts",
            "de": "Bots bereit",
            "es": "Bots listos"
          }
        },
        {
          "match": "World Initialized In",
          "progress": 0.98,
          "label": {
            "en": "Opening the realm",
            "fr": "Ouverture du royaume",
            "de": "Realm wird geöffnet",
            "es": "Abriendo el reino"
          }
        }
      ]
    }
  ],
  "settings": [
    {
      "id": "rates",
      "label": {
        "en": "Rates",
        "fr": "Taux",
        "de": "Raten",
        "es": "Tasas"
      },
      "options": [
        {
          "id": "xp-kill",
          "type": "number",
          "label": {
            "en": "Experience from kills",
            "fr": "Expérience des monstres tués",
            "de": "Erfahrung durch getötete Monster",
            "es": "Experiencia por monstruos muertos"
          },
          "target": {
            "file": "worldserver.conf",
            "key": "Rate.XP.Kill"
          },
          "default": 1,
          "min": 0,
          "max": 50,
          "help": {
            "en": "1 = normal speed, 2 = twice as fast. 0 turns it off.",
            "fr": "1 = vitesse normale, 2 = deux fois plus vite. 0 la désactive.",
            "de": "1 = normale Geschwindigkeit, 2 = doppelt so schnell. 0 schaltet sie ab.",
            "es": "1 = velocidad normal, 2 = el doble de rápido. 0 la desactiva."
          }
        },
        {
          "id": "xp-quest",
          "type": "number",
          "label": {
            "en": "Experience from quests",
            "fr": "Expérience des quêtes",
            "de": "Erfahrung durch Quests",
            "es": "Experiencia por misiones"
          },
          "target": {
            "file": "worldserver.conf",
            "key": "Rate.XP.Quest"
          },
          "default": 1,
          "min": 0,
          "max": 50
        },
        {
          "id": "xp-explore",
          "type": "number",
          "label": {
            "en": "Experience from exploration",
            "fr": "Expérience d'exploration",
            "de": "Erfahrung durch Erkundung",
            "es": "Experiencia por exploración"
          },
          "target": {
            "file": "worldserver.conf",
            "key": "Rate.XP.Explore"
          },
          "default": 1,
          "min": 0,
          "max": 50
        },
        {
          "id": "reputation",
          "type": "number",
          "label": {
            "en": "Reputation gains",
            "fr": "Gains de réputation",
            "de": "Rufgewinn",
            "es": "Ganancia de reputación"
          },
          "target": {
            "file": "worldserver.conf",
            "key": "Rate.Reputation.Gain"
          },
          "default": 1,
          "min": 0,
          "max": 50
        },
        {
          "id": "honor",
          "type": "number",
          "label": {
            "en": "Honor gains",
            "fr": "Gains d'honneur",
            "de": "Ehregewinn",
            "es": "Ganancia de honor"
          },
          "target": {
            "file": "worldserver.conf",
            "key": "Rate.Honor"
          },
          "default": 1,
          "min": 0,
          "max": 50
        },
        {
          "id": "money",
          "type": "number",
          "label": {
            "en": "Money looted",
            "fr": "Argent ramassé",
            "de": "Erbeutetes Geld",
            "es": "Dinero despojado"
          },
          "target": {
            "file": "worldserver.conf",
            "key": "Rate.Drop.Money"
          },
          "default": 1,
          "min": 0,
          "max": 50
        },
        {
          "id": "drop-uncommon",
          "type": "number",
          "label": {
            "en": "Uncommon item drops (green)",
            "fr": "Butin d'objets inhabituels (verts)",
            "de": "Beute: seltene Gegenstände (grün)",
            "es": "Botín: objetos poco comunes (verdes)"
          },
          "target": {
            "file": "worldserver.conf",
            "key": "Rate.Drop.Item.Uncommon"
          },
          "default": 1,
          "min": 0,
          "max": 50
        },
        {
          "id": "drop-rare",
          "type": "number",
          "label": {
            "en": "Rare item drops (blue)",
            "fr": "Butin d'objets rares (bleus)",
            "de": "Beute: rare Gegenstände (blau)",
            "es": "Botín: objetos raros (azules)"
          },
          "target": {
            "file": "worldserver.conf",
            "key": "Rate.Drop.Item.Rare"
          },
          "default": 1,
          "min": 0,
          "max": 50
        },
        {
          "id": "drop-epic",
          "type": "number",
          "label": {
            "en": "Epic item drops (purple)",
            "fr": "Butin d'objets épiques (violets)",
            "de": "Beute: epische Gegenstände (lila)",
            "es": "Botín: objetos épicos (morados)"
          },
          "target": {
            "file": "worldserver.conf",
            "key": "Rate.Drop.Item.Epic"
          },
          "default": 1,
          "min": 0,
          "max": 50
        },
        {
          "id": "skill-crafting",
          "type": "integer",
          "label": {
            "en": "Crafting skill gains",
            "fr": "Progression des métiers d'artisanat",
            "de": "Fortschritt der Herstellungsberufe",
            "es": "Progreso de las profesiones de fabricación"
          },
          "target": {
            "file": "worldserver.conf",
            "key": "SkillGain.Crafting"
          },
          "default": 1,
          "min": 1,
          "max": 10,
          "help": {
            "en": "Skill points per gain: 2 = twice as fast.",
            "fr": "Points gagnés à chaque progression : 2 = deux fois plus vite.",
            "de": "Fertigkeitspunkte pro Steigerung: 2 = doppelt so schnell.",
            "es": "Puntos ganados en cada subida: 2 = el doble de rápido."
          }
        },
        {
          "id": "skill-gathering",
          "type": "integer",
          "label": {
            "en": "Gathering and fishing skill gains",
            "fr": "Progression de la cueillette, du minage, du dépeçage et de la pêche",
            "de": "Fortschritt von Kräuterkunde, Bergbau, Kürschnerei und Angeln",
            "es": "Progreso de herboristería, minería, desuello y pesca"
          },
          "target": {
            "file": "worldserver.conf",
            "key": "SkillGain.Gathering"
          },
          "default": 1,
          "min": 1,
          "max": 10,
          "help": {
            "en": "Skill points per gain: 2 = twice as fast.",
            "fr": "Points gagnés à chaque progression : 2 = deux fois plus vite.",
            "de": "Fertigkeitspunkte pro Steigerung: 2 = doppelt so schnell.",
            "es": "Puntos ganados en cada subida: 2 = el doble de rápido."
          }
        },
        {
          "id": "arena-points",
          "type": "number",
          "label": {
            "en": "Arena points",
            "fr": "Points d'arène",
            "de": "Arenapunkte",
            "es": "Puntos de arena"
          },
          "target": {
            "file": "worldserver.conf",
            "key": "Rate.ArenaPoints"
          },
          "default": 1,
          "min": 0,
          "max": 50
        }
      ]
    },
    {
      "id": "realm",
      "label": {
        "en": "Realm",
        "fr": "Royaume",
        "de": "Realm",
        "es": "Reino"
      },
      "options": [
        {
          "id": "realm-type",
          "type": "choice",
          "label": {
            "en": "Realm type",
            "fr": "Type de royaume",
            "de": "Realmtyp",
            "es": "Tipo de reino"
          },
          "default": "normal",
          "choices": [
            {
              "id": "normal",
              "label": {
                "en": "Normal (PvE)",
                "fr": "Normal (JcE)",
                "de": "Normal (PvE)",
                "es": "Normal (JcE)"
              },
              "config": {
                "worldserver.conf": {
                  "GameType": 0
                }
              }
            },
            {
              "id": "pvp",
              "label": {
                "en": "PvP",
                "fr": "JcJ",
                "de": "PvP",
                "es": "JcJ"
              },
              "config": {
                "worldserver.conf": {
                  "GameType": 1
                }
              }
            },
            {
              "id": "rp",
              "label": {
                "en": "Role-play",
                "fr": "Jeu de rôle",
                "de": "Rollenspiel",
                "es": "Rol"
              },
              "config": {
                "worldserver.conf": {
                  "GameType": 6
                }
              }
            },
            {
              "id": "rp-pvp",
              "label": {
                "en": "Role-play PvP",
                "fr": "Jeu de rôle JcJ",
                "de": "Rollenspiel-PvP",
                "es": "Rol JcJ"
              },
              "config": {
                "worldserver.conf": {
                  "GameType": 8
                }
              }
            },
            {
              "id": "ffa-pvp",
              "label": {
                "en": "Free-for-all PvP",
                "fr": "JcJ sauvage (tous contre tous)",
                "de": "Freies PvP (jeder gegen jeden)",
                "es": "JcJ libre (todos contra todos)"
              },
              "config": {
                "worldserver.conf": {
                  "GameType": 16
                }
              }
            }
          ],
          "help": {
            "en": "PvP realms flag players for combat in contested zones. Also shown in the game's realm list.",
            "fr": "Sur un royaume JcJ, les joueurs sont attaquables dans les zones contestées. Affiché aussi dans la liste des royaumes du jeu.",
            "de": "Auf PvP-Realms sind Spieler in umkämpften Gebieten angreifbar. Wird auch in der Realmliste des Spiels angezeigt.",
            "es": "En los reinos JcJ, los jugadores pueden ser atacados en las zonas en disputa. También se muestra en la lista de reinos del juego."
          }
        },
        {
          "id": "cross-faction-group",
          "type": "boolean",
          "label": {
            "en": "Groups between factions",
            "fr": "Groupes entre factions",
            "de": "Gruppen über Fraktionen hinweg",
            "es": "Grupos entre facciones"
          },
          "target": {
            "file": "worldserver.conf",
            "key": "AllowTwoSide.Interaction.Group"
          },
          "default": false
        },
        {
          "id": "cross-faction-guild",
          "type": "boolean",
          "label": {
            "en": "Guilds between factions",
            "fr": "Guildes entre factions",
            "de": "Gilden über Fraktionen hinweg",
            "es": "Hermandades entre facciones"
          },
          "target": {
            "file": "worldserver.conf",
            "key": "AllowTwoSide.Interaction.Guild"
          },
          "default": false
        },
        {
          "id": "cross-faction-chat",
          "type": "boolean",
          "label": {
            "en": "Chat between factions",
            "fr": "Discussion entre factions",
            "de": "Chat über Fraktionen hinweg",
            "es": "Chat entre facciones"
          },
          "target": {
            "file": "worldserver.conf",
            "key": "AllowTwoSide.Interaction.Chat"
          },
          "default": false
        },
        {
          "id": "cross-faction-auction",
          "type": "boolean",
          "label": {
            "en": "Shared auction houses",
            "fr": "Hôtels des ventes communs aux factions",
            "de": "Gemeinsame Auktionshäuser",
            "es": "Casas de subastas comunes a las facciones"
          },
          "target": {
            "file": "worldserver.conf",
            "key": "AllowTwoSide.Interaction.Auction"
          },
          "default": false
        },
        {
          "id": "instance-ignore-level",
          "type": "boolean",
          "label": {
            "en": "Enter dungeons at any level",
            "fr": "Entrer dans les donjons à tout niveau",
            "de": "Dungeons auf jeder Stufe betreten",
            "es": "Entrar en mazmorras a cualquier nivel"
          },
          "target": {
            "file": "worldserver.conf",
            "key": "Instance.IgnoreLevel"
          },
          "default": false
        },
        {
          "id": "instance-ignore-raid",
          "type": "boolean",
          "label": {
            "en": "Enter raids without a raid group",
            "fr": "Entrer en raid sans groupe de raid",
            "de": "Schlachtzüge ohne Schlachtzugsgruppe betreten",
            "es": "Entrar en bandas sin grupo de banda"
          },
          "target": {
            "file": "worldserver.conf",
            "key": "Instance.IgnoreRaid"
          },
          "default": false
        },
        {
          "id": "instance-reset",
          "type": "choice",
          "label": {
            "en": "Raid lockout reset",
            "fr": "Réinitialisation des raids",
            "de": "Zurücksetzen der Schlachtzüge",
            "es": "Reinicio de las bandas"
          },
          "default": "weekly",
          "choices": [
            {
              "id": "weekly",
              "label": {
                "en": "Weekly (normal)",
                "fr": "Chaque semaine (normal)",
                "de": "Jede Woche (normal)",
                "es": "Cada semana (normal)"
              },
              "config": {
                "worldserver.conf": {
                  "Rate.InstanceResetTime": 1
                }
              }
            },
            {
              "id": "three-days",
              "label": {
                "en": "Every 3 days",
                "fr": "Tous les 3 jours",
                "de": "Alle 3 Tage",
                "es": "Cada 3 días"
              },
              "config": {
                "worldserver.conf": {
                  "Rate.InstanceResetTime": 0.43
                }
              }
            },
            {
              "id": "daily",
              "label": {
                "en": "Every day",
                "fr": "Chaque jour",
                "de": "Jeden Tag",
                "es": "Cada día"
              },
              "config": {
                "worldserver.conf": {
                  "Rate.InstanceResetTime": 0.15
                }
              }
            }
          ],
          "help": {
            "en": "Heroic dungeons already reset every day. A change takes effect after the reset already planned.",
            "fr": "Les donjons héroïques se réinitialisent déjà chaque jour. Un changement prend effet après la réinitialisation déjà prévue.",
            "de": "Heroische Dungeons werden bereits täglich zurückgesetzt. Eine Änderung wirkt nach dem bereits geplanten Zurücksetzen.",
            "es": "Las mazmorras heroicas ya se reinician cada día. Un cambio surte efecto tras el reinicio ya previsto."
          }
        }
      ]
    },
    {
      "id": "characters",
      "label": {
        "en": "Characters",
        "fr": "Personnages",
        "de": "Charaktere",
        "es": "Personajes"
      },
      "options": [
        {
          "id": "max-level",
          "type": "integer",
          "label": {
            "en": "Maximum level",
            "fr": "Niveau maximum",
            "de": "Höchststufe",
            "es": "Nivel máximo"
          },
          "target": {
            "file": "worldserver.conf",
            "key": "MaxPlayerLevel"
          },
          "default": 80,
          "min": 1,
          "max": 80
        },
        {
          "id": "start-level",
          "type": "integer",
          "label": {
            "en": "Starting level",
            "fr": "Niveau de départ",
            "de": "Startstufe",
            "es": "Nivel inicial"
          },
          "target": {
            "file": "worldserver.conf",
            "key": "StartPlayerLevel"
          },
          "default": 1,
          "min": 1,
          "max": 80
        },
        {
          "id": "start-level-heroic",
          "type": "integer",
          "label": {
            "en": "Death Knight starting level",
            "fr": "Niveau de départ des chevaliers de la mort",
            "de": "Startstufe der Todesritter",
            "es": "Nivel inicial de los caballeros de la Muerte"
          },
          "target": {
            "file": "worldserver.conf",
            "key": "StartHeroicPlayerLevel"
          },
          "default": 55,
          "min": 55,
          "max": 80
        },
        {
          "id": "start-money",
          "type": "integer",
          "label": {
            "en": "Starting money (copper)",
            "fr": "Argent de départ (cuivre)",
            "de": "Startgeld (Kupfer)",
            "es": "Dinero inicial (cobre)"
          },
          "target": {
            "file": "worldserver.conf",
            "key": "StartPlayerMoney"
          },
          "default": 0,
          "min": 0,
          "max": 2000000000,
          "help": {
            "en": "In copper coins: 100 = 1 silver, 10000 = 1 gold.",
            "fr": "En pièces de cuivre : 100 = 1 argent, 10000 = 1 or.",
            "de": "In Kupfermünzen: 100 = 1 Silber, 10000 = 1 Gold.",
            "es": "En monedas de cobre: 100 = 1 de plata, 10000 = 1 de oro."
          }
        },
        {
          "id": "all-flight-paths",
          "type": "boolean",
          "label": {
            "en": "Know every flight path",
